NODE_ENV=development
PORT=4000

# Mongo
MONGODB_URI=mongodb://itvit:itvit@localhost:27018/itvit?authSource=admin

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=7d

# CORS / frontend
FRONTEND_ORIGIN=http://localhost:3003

# WemoPay (hosted checkout). Без WEMOPAY_API_KEY кнопка оплаты отвечает 503.
# Боевой хост: https://engine-external.wemopay.net, песочница: https://engine-sandbox.wemopay.net
WEMOPAY_BASE_URL=https://engine-sandbox.wemopay.net
WEMOPAY_API_KEY=
WEMOPAY_SIGNING_KEY=
# Вебхук должен быть доступен провайдеру снаружи — localhost не подойдёт.
WEMOPAY_WEBHOOK_URL=https://portable.digital/api/payments/webhook
# {referenceId} заменяется номером заказа.
WEMOPAY_RETURN_URL=http://localhost:3020/orders/{referenceId}

# Почта (письмо после оплаты). Без SMTP_HOST/USER/PASS письма копятся в mail_outbox
# и уходят, как только почту настроят. Локально удобен Mailpit (порт 1025, SMTP_SECURE=false).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Portable digital <no-reply@portable.digital>
MAIL_REPLY_TO=
PUBLIC_SITE_URL=http://localhost:3020
